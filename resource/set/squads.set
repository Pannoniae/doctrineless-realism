{squads
	{competitive
		{placerMin				8.0}	;// min distance between units in cluster, meters
		{placerMax				100.0}	;// max distance between units in cluster, meters
		{placerRadius			200.0}	;// max distance between units allowed for placer, meters
		{placerCommanderAhead	-8}		;// distance between commander and his squad
	}
	{cooperative
		{placerMin				8.0}	;// min distance between units in cluster, meters
		{placerMax				40.0}	;// max distance between units in cluster, meters
		{placerRadius			40.0}	;// max distance between units allowed for placer, meters
		{placerCommanderAhead	0}		;// distance between commander and his squad
	}
}